# Supabase (service role — RLS 우회용, 절대 공개 금지)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 네이버 블로그
NAVER_BLOG_ID=white0028

# 티스토리 (예: https://myblog.tistory.com → myblog)
TISTORY_BLOG_NAME=

# 구글 블로거
# Google Cloud Console > APIs & Services > Credentials 에서
# "Desktop app" OAuth 클라이언트 JSON을 내려받아 경로를 적으세요.
GOOGLE_OAUTH_CLIENT_SECRET_PATH=./client_secret.json
# auth:blogger 실행 후 출력되는 blogId
BLOGGER_BLOG_ID=
